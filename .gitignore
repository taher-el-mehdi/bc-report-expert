## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Based on https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
Microsoft.RdlcDesigner
# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.env
*.env.*
!.env.example

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
[Aa][Rr][Mm]64[Ee][Cc]/
bld/
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/
artifacts/

# Visual Studio cache/options
.vs/

# Visual Studio auto generated files
Generated\ Files/

# MSTest / NUnit / coverage
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.VisualState.xml
TestResult.xml
nunit-*.xml
*.received.*
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info

# .NET Core
project.lock.json
project.fragment.lock.json

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# Others
ClientBin/
~$*
*~
*.dbmdl
*.dbproj.schemaview
*.jfm
*.pfx
*.publishsettings
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.log
*.tlog
*.binlog
MSBuild_Logs/
bin
# Publish / ClickOnce
publish/
*.[Pp]ublish.xml
*.azurePubxml
*.pubxml
*.publishproj
AppPackages/
BundleArtifacts/
Package.StoreAssociation.xml
*.appx
*.appxbundle
*.appxupload

# Cache
*.[Cc]ache
!?*.[Cc]ache/

# ReSharper / Rider / JetBrains
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
.idea/

# Node (scripts / tooling)
node_modules/
*.vsix

# VS Code (keep shared launch/tasks; ignore local MCP secrets)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.vscode/mcp.json
.history/

# Cursor / local AI tooling
.cursor/
.claude/

# Local History
**/.localhistory/
.vshistory/

# Python helpers
**/__pycache__/
*.pyc

# Secrets / local Copilot settings (never commit)
**/copilot.json
**/secrets.json
**/appsettings.*.local.json

# OS junk
Thumbs.db
Desktop.ini
.DS_Store

# Temporary / scratch
*.bak
*.swp
rdl-preview-VsCodeExtension-master/
