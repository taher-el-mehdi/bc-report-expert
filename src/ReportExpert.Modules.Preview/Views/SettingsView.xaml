<UserControl x:Class="ReportExpert.Modules.Preview.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:ReportExpert.Modules.Preview.Helpers">

    <UserControl.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
        <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />
        <helpers:ProviderNameConverter x:Key="ProviderNameConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="12,8" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Settings24" Margin="0,0,8,0" />
                    <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text=" — changes save automatically" Margin="8,0,0,0" Opacity="0.6" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                           Opacity="0.6" FontSize="12"
                           Text="{Binding StatusMessage}" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel MaxWidth="960" HorizontalAlignment="Stretch">

                <!-- Appearance + Preview -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Appearance" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <Border CornerRadius="8" Padding="16"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding ThemeOptions}"
                                          SelectedItem="{Binding Theme, Mode=TwoWay}"
                                          Margin="0,0,0,16" />

                                <TextBlock Text="Layout designer" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Text="Rulers and gridlines on the RDLC design surface."
                                           FontSize="12" Opacity="0.6" Margin="0,0,0,10" TextWrapping="Wrap" />
                                <ui:ToggleSwitch Content="Show rulers"
                                                 IsChecked="{Binding ShowDesignerRulers, Mode=TwoWay}"
                                                 Margin="0,0,0,8" />
                                <ui:ToggleSwitch Content="Show gridlines"
                                                 IsChecked="{Binding ShowDesignerGridlines, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Preview" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <Border CornerRadius="8" Padding="16"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Sample rows per dataset" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Text="Used when generating dummy data for RDLC preview (1–500)."
                                           FontSize="12" Opacity="0.6" Margin="0,0,0,8" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ui:Button Content="10"
                                               MinWidth="48"
                                               Padding="12,6"
                                               Margin="0,0,6,0"
                                               Appearance="{Binding Rows10Appearance}"
                                               Command="{Binding SetRowCountCommand}"
                                               CommandParameter="10" />
                                    <ui:Button Content="50"
                                               MinWidth="48"
                                               Padding="12,6"
                                               Margin="0,0,6,0"
                                               Appearance="{Binding Rows50Appearance}"
                                               Command="{Binding SetRowCountCommand}"
                                               CommandParameter="50" />
                                    <ui:Button Content="Custom"
                                               MinWidth="72"
                                               Padding="12,6"
                                               Appearance="{Binding RowsCustomAppearance}"
                                               Command="{Binding UseCustomRowCountCommand}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,20"
                                            Visibility="{Binding IsCustomRowCount, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Number of rows"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"
                                               Opacity="0.8" />
                                    <ui:NumberBox Width="120"
                                                  MinHeight="36"
                                                  FontSize="14"
                                                  SpinButtonPlacementMode="Inline"
                                                  Minimum="1"
                                                  Maximum="500"
                                                  Value="{Binding RowsGenerated, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="Custom row count (1–500)" />
                                </StackPanel>

                                <TextBlock Text="Default export folder" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding DefaultExportFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Browse"
                                               Command="{Binding BrowseExportFolderCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Copilot AI -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Copilot AI" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <Border CornerRadius="8" Padding="16"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Provider" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding ProviderOptions}"
                                      SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                                      Margin="0,0,0,12">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource ProviderNameConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="API key" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="ApiKeyBox"
                                             PasswordChanged="ApiKeyBox_PasswordChanged" />
                                <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Get key"
                                           Command="{Binding GetApiKeyCommand}"
                                           ToolTip="{Binding GetApiKeyToolTip}" />
                                <ui:Button Grid.Column="2" Margin="8,0,0,0" Content="Test"
                                           Command="{Binding TestApiKeyCommand}"
                                           ToolTip="Send a short request to verify the API key" />
                            </Grid>
                            <TextBlock Text="{Binding ApiKeyTestMessage}"
                                       Margin="0,0,0,12"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       MinHeight="16" />

                            <TextBlock Text="Model" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding ModelOptions}"
                                      SelectedValuePath="ModelId"
                                      SelectedValue="{Binding Model, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,2">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                            <TextBlock FontSize="11" Opacity="0.65"
                                                       Text="{Binding ModelId}" FontFamily="Consolas" />
                                            <TextBlock FontSize="11" Opacity="0.55"
                                                       Text="{Binding BestFor}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Agent mode and the MCP servers that provide its tools -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Agent mode" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <Border CornerRadius="8" Padding="16"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel>
                            <ui:ToggleSwitch Content="Let Copilot edit reports"
                                             IsChecked="{Binding AgentModeEnabled, Mode=TwoWay}" />
                            <TextBlock Margin="0,6,0,16"
                                       FontSize="12"
                                       Opacity="0.65"
                                       TextWrapping="Wrap"
                                       Text="Copilot can inspect and change the open report using the tools below. You approve every change before it is made, and the file is backed up first." />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Tool servers" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Edit list"
                                           Command="{Binding EditMcpConfigurationCommand}"
                                           ToolTip="{Binding McpConfigurationPath}" />
                                <ui:Button Grid.Column="2" Margin="8,0,0,0" Content="Restart"
                                           Command="{Binding RestartMcpCommand}"
                                           IsEnabled="{Binding IsRefreshingMcp, Converter={StaticResource InverseBoolConverter}}"
                                           ToolTip="Reconnect, picking up any changes to the list" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding McpServers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,4"
                                                Padding="12,8"
                                                CornerRadius="6"
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                            <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                      ExpandDirection="Down">
                                                <Expander.Header>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Id}"
                                                                       FontWeight="SemiBold"
                                                                       FontFamily="Consolas"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Margin="10,0,0,0"
                                                                       FontSize="11"
                                                                       Opacity="0.7"
                                                                       VerticalAlignment="Center"
                                                                       Text="{Binding ToolCountLabel}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Command}"
                                                                   FontSize="11"
                                                                   Opacity="0.55"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding LastError}"
                                                                   FontSize="11"
                                                                   Margin="0,4,0,0"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </Expander.Header>

                                                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Tools}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,2"
                                                                    Padding="8,6"
                                                                    CornerRadius="4"
                                                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Margin="0,0,12,0">
                                                                        <TextBlock Text="{Binding Name}"
                                                                                   FontFamily="Consolas"
                                                                                   FontSize="12"
                                                                                   FontWeight="SemiBold" />
                                                                        <TextBlock Text="{Binding Description}"
                                                                                   FontSize="11"
                                                                                   Opacity="0.6"
                                                                                   TextWrapping="Wrap"
                                                                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />
                                                                    </StackPanel>
                                                                    <ui:ToggleSwitch Grid.Column="1"
                                                                                     VerticalAlignment="Center"
                                                                                     IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                                     ToolTip="When off, Copilot cannot call this tool" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock HorizontalAlignment="Center" Margin="0,8,0,24" Opacity="0.6" FontSize="12"
                           Text="Version 1.0 Marmoset" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
