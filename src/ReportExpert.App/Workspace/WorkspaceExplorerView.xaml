<UserControl x:Class="ReportExpert.App.Workspace.WorkspaceExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.Resources>
        <ContextMenu x:Key="AddContextMenu">
            <MenuItem Header="New layout…"
                      Command="{Binding CreateNewLayoutCommand}" />
        </ContextMenu>
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0"
            Background="{DynamicResource ApplicationBackgroundBrush}">
        <DockPanel>
            <Border DockPanel.Dock="Top"
                    Padding="12,10"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding WorkspaceName}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding WorkspaceSummary}"
                                   FontSize="11"
                                   Opacity="0.6"
                                   Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button Appearance="Transparent"
                                   Padding="6"
                                   ToolTip="Open another project"
                                   Command="{Binding OpenProjectCommand}">
                            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14" />
                        </ui:Button>
                        <ui:Button Appearance="Transparent"
                                   Padding="6"
                                   ToolTip="Add layout"
                                   Click="AddMenuButton_Click">
                            <ui:SymbolIcon Symbol="Add24" FontSize="14" />
                        </ui:Button>
                        <ui:Button Appearance="Transparent"
                                   Padding="6"
                                   ToolTip="Refresh project"
                                   Command="{Binding RefreshWorkspaceCommand}">
                            <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" />
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Top"
                    Padding="10,8"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Search24"
                                   FontSize="14"
                                   Opacity="0.55"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center" />
                    <ui:TextBox Grid.Column="1"
                                PlaceholderText="Search layouts"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                ClearButtonEnabled="True"
                                BorderThickness="0"
                                Background="Transparent"
                                Padding="0,2" />
                </Grid>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8,8,8,12">
                    <TextBlock Text="No matching layouts"
                               FontSize="11"
                               Opacity="0.5"
                               Margin="8,4"
                               Visibility="{Binding FilteredItems.Count, Converter={StaticResource EmptyListVis}}" />

                    <ItemsControl ItemsSource="{Binding FilteredItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6"
                                        Margin="0,1"
                                        CornerRadius="4"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="WorkspaceNodeHeader_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Type badge + icon -->
                                        <Border Width="28" Height="28"
                                                CornerRadius="6"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Top">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1A2E7CD6" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding File.LayoutFormat}" Value="Excel">
                                                            <Setter Property="Background" Value="#1A107C41" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding File.LayoutFormat}" Value="Word">
                                                            <Setter Property="Background" Value="#1A2B579A" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding File.LayoutFormat}" Value="RDLC">
                                                            <Setter Property="Background" Value="#1AC43E1C" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <ui:SymbolIcon FontSize="14"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Symbol" Value="DocumentText24" />
                                                        <Setter Property="Foreground" Value="#C43E1C" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding File.LayoutFormat}" Value="Excel">
                                                                <Setter Property="Symbol" Value="Table24" />
                                                                <Setter Property="Foreground" Value="#107C41" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding File.LayoutFormat}" Value="Word">
                                                                <Setter Property="Symbol" Value="DocumentOnePage24" />
                                                                <Setter Property="Foreground" Value="#2B579A" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding File.LayoutFormat}" Value="RDLC">
                                                                <Setter Property="Symbol" Value="DocumentRibbon24" />
                                                                <Setter Property="Foreground" Value="#C43E1C" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                        </Border>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DisplayTitle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding Summary}"
                                                       FontSize="10"
                                                       Opacity="0.5"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
