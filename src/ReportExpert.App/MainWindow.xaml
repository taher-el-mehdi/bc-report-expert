<ui:FluentWindow x:Class="ReportExpert.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:preview="clr-namespace:ReportExpert.Modules.Preview.Views;assembly=ReportExpert.Modules.Preview"
                 xmlns:home="clr-namespace:ReportExpert.App.Home"
                 xmlns:ws="clr-namespace:ReportExpert.App.Workspace"
                 Title="{Binding WindowTitle}"
                 Icon="pack://application:,,,/Assets/app-icon.ico"
                 Height="860"
                 Width="1360"
                 MinHeight="640"
                 MinWidth="1000"
                 WindowStartupLocation="CenterScreen"
                 WindowState="Maximized"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Margin" Value="6,3" />
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{Binding WindowTitle}"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True"
                     CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon x:Name="AppLogo" Width="22" Height="22" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation rail -->
            <Border Grid.Column="0" BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <DockPanel Margin="0,8,0,8" LastChildFill="True">
                    <RadioButton x:Name="NavSettings" DockPanel.Dock="Bottom"
                                 Style="{StaticResource NavButton}"
                                 GroupName="Nav" ToolTip="Application settings">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="Settings24" FontSize="20" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Settings" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </RadioButton>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <RadioButton x:Name="NavHome" Style="{StaticResource NavButton}" IsChecked="True"
                                     GroupName="Nav" ToolTip="Home — edit layouts &amp; Copilot">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="Home24" FontSize="20" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Home" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ws:WorkspaceExplorerView x:Name="WorkspaceExplorer"
                                          Grid.Column="0"
                                          Width="300"
                                          Visibility="{Binding HasWorkspace, Converter={StaticResource BoolToVis}}" />

                <Grid Grid.Column="1">
                    <home:HomeView x:Name="HomeFeature"
                                   Visibility="{Binding IsChecked, ElementName=NavHome, Converter={StaticResource BoolToVis}}" />

                    <preview:SettingsView x:Name="SettingsFeature"
                                          Visibility="{Binding IsChecked, ElementName=NavSettings, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
